{
  "enabledMcpjsonServers": ["filesystem", "incidents"],
  "permissions": {
    "allow": [
      "mcp__filesystem__read_text_file",
      "mcp__filesystem__read_multiple_files",
      "mcp__filesystem__list_directory",
      "mcp__filesystem__list_allowed_directories",
      "mcp__incidents__get_incident_stats",
      "mcp__incidents__search_incidents"
    ],
    "ask": [
      "mcp__filesystem__write_file",
      "Bash(git commit *)"
    ],
    "deny": [
      "mcp__filesystem__move_file",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Read(./.env)"
    ]
  }
}
