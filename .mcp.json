{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "./data",
        "./reports"
      ],
      "env": {}
    },
    "incidents": {
      "type": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "mcp-servers/incidents/server.ts"],
      "env": {}
    }
  }
}
